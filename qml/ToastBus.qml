pragma Singleton
import QtQuick

// Toast 互斥总线。
//
// 为什么需要：全项目有 8 个 Toast 实例（各工位页各一个 + 窗口层 + 日志模态框），
// 全都锚在窗口底部正中、同一个 z —— 两个同时 show() 就叠在一起，文字互相透叠完全
// 读不清（2026-08-21 实测：切设备那一刻「已自动切到下一台」与「请从搜索结果里选择
// IP」重叠）。
//
// 逐个去排"谁在什么时机发"不现实（8 个实例两两组合），所以让它们互斥：谁 show()
// 就领一个新令牌，令牌被超越的旧 Toast 立刻隐藏自己。以后无论谁在什么时机发都不会
// 再叠。
QtObject {
    // 单调递增。Toast.show() 里 ++ 后记下自己的值，看到 token 变大就说明被顶替了。
    property int token: 0
}
